# Base URL for the itable app backend API. Leave empty in local development
# (the Vite dev server proxies /api to VITE_API_PROXY_TARGET, see
# vite.config.ts) — set this to the deployed backend's origin in production
# builds, e.g. https://api.itable.app
VITE_API_BASE_URL=

# Only used by the Vite dev server proxy (not bundled into the app).
VITE_API_PROXY_TARGET=http://localhost:8000
