# Application
PROJECT_NAME="itable app"
ENVIRONMENT=development

# PostgreSQL connection string (SQLAlchemy 2.0 / psycopg2)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/itable

# Parrot POS integration
PARROT_API_BASE_URL=https://api.parrotpos.com

# Fugas engine thresholds
FUGAS_ZSCORE_HIGH_RISK=2.0
FUGAS_ZSCORE_MEDIUM_RISK=1.0
FUGAS_HIGH_RISK_MIN_AMOUNT=1000.0
